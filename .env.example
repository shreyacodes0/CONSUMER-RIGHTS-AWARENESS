# NyayaDesk Environment Configuration Template
# Consumer Legal Awareness & Information Platform

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain a free-tier API key via Google AI Studio: https://aistudio.google.com/
# In Google AI Studio, this is injected automatically at runtime.
GEMINI_API_KEY="your-gemini-api-key-here"

# GEMINI_MODEL: Model identifier supported by Gemini free tier.
# Free-tier eligible models include 'gemini-2.5-flash' or 'gemini-1.5-flash'.
GEMINI_MODEL="gemini-2.5-flash"

# ADMIN_API_KEY: Secret key required for administrative document ingestion and deletion endpoints.
ADMIN_API_KEY="nyayadesk-admin-dev-key"

# APP_URL: The hosting URL (injected by AI Studio runtime).
APP_URL="http://localhost:3000"
